<?xml version="1.0"?>
<robot name="kuka_lbr_iiwa14_r820" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Shared robot model -->
  <xacro:include filename="$(find lbr_iiwa14_r820_description)/urdf/lbr_iiwa14_r820.urdf.xacro"/>

  <!-- Gazebo-specific ros2_control configuration -->
  <xacro:include filename="$(find kuka_gazebo)/urdf/kuka_gazebo_control.xacro"/>

  <!-- Fix KUKA base to Gazebo world -->
  <link name="world"/>

  <joint name="world_to_kuka_base" type="fixed">
    <parent link="world"/>
    <child link="lbr_link_0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>