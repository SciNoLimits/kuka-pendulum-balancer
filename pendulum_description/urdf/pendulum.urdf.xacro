<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================= -->
  <!-- SINGLE DOF PENDULUM MACRO         -->
  <!-- ================================= -->

  <xacro:macro name="pendulum" params="parent prefix:=pendulum_">

    <!-- ================================= -->
    <!-- PENDULUM: RIGID MOVING LINK       -->
    <!-- ================================= -->

    <link name="${prefix}link">

      <!-- Inertial properties -->
      <inertial>
        <origin xyz="0 0 -0.23" rpy="0 0 0"/>

        <mass value="0.22"/>

        <inertia
          ixx="0.0038"
          ixy="0"
          ixz="0"
          iyy="0.0038"
          iyz="0"
          izz="0.00002"/>
      </inertial>


      <!-- ================================= -->
      <!-- CONNECTING HUB AT THE PIVOT      -->
      <!-- ================================= -->

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.015" length="0.015"/>
        </geometry>

        <material name="pendulum_hub_material">
          <color rgba="0.68 0.70 0.74 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.015" length="0.015"/>
        </geometry>
      </collision>


      <!-- ================================= -->
      <!-- METALLIC PENDULUM ROD             -->
      <!-- ================================= -->

      <visual>
        <origin xyz="0 0 -0.23" rpy="0 0 0"/>

        <geometry>
          <cylinder radius="0.009" length="0.46"/>
        </geometry>

        <material name="pendulum_rod_material">
          <color rgba="0.68 0.70 0.74 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 -0.23" rpy="0 0 0"/>

        <geometry>
          <cylinder radius="0.009" length="0.46"/>
        </geometry>
      </collision>


      <!-- ================================= -->
      <!-- SPHERICAL PENDULUM BOB            -->
      <!-- ================================= -->

      <visual>
        <origin xyz="0 0 -0.46" rpy="0 0 0"/>

        <geometry>
          <sphere radius="0.03"/>
        </geometry>

        <material name="pendulum_bob_material">
          <color rgba="1.0 0.40 0.02 1"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 -0.46" rpy="0 0 0"/>

        <geometry>
          <sphere radius="0.03"/>
        </geometry>
      </collision>

    </link>


    <!-- ================================= -->
    <!-- SINGLE REVOLUTE JOINT             -->
    <!-- ================================= -->

    <joint name="${prefix}joint" type="revolute">

      <parent link="${parent}"/>
      <child link="${prefix}link"/>

      <!-- Joint located at the pendulum pivot -->
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <!-- Rotation axis -->
      <axis xyz="0 1 0"/>

      <!-- Joint limits -->
      <limit
        lower="-3.14159"
        upper="3.14159"
        effort="10"
        velocity="10"/>

      <!-- Joint dynamics -->
      <dynamics
        damping="0.002"
        friction="0.0005"/>

    </joint>

  </xacro:macro>

</robot>